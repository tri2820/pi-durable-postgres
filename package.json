{
  "name": "@tri2820/pi-durable-postgres",
  "version": "0.3.0",
  "description": "PostgreSQL storage backend for @earendil-works/pi-durable. Fork of @netzlabor/pi-durable-postgres, ported to pi-durable 1.5.x.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "test:types": "tsc --noEmit && tsc -p tsconfig.test.json",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "peerDependencies": {
    "@earendil-works/chord": ">=1.5.2 <2",
    "@earendil-works/pi-durable": ">=1.5.2 <2"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@types/bun": "^1.4.4",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "pi-durable",
    "pi",
    "postgres",
    "postgresql",
    "agent",
    "durable"
  ],
  "homepage": "https://github.com/tri2820/pi-durable-postgres#readme",
  "bugs": {
    "url": "https://github.com/tri2820/pi-durable-postgres/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tri2820/pi-durable-postgres.git"
  }
}
